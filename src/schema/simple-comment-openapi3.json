    "/auth": {
      "post": {
        "summary": "Log in with HTTP Basic credentials",
        "description": "Send the user ID or email and password in the HTTP Basic Authorization header. A successful login sets the simple_comment_token cookie.",
        "responses": {
          "200": {
            "description": "User authenticated",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "OK"
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "Sets the HttpOnly simple_comment_token cookie to the JWT. The cookie uses SameSite=Strict or SameSite=None with Secure, depending on the deployment configuration.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "HTTP Basic credentials are missing or invalid",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "description": "HTTP Basic challenge sent when HTTP Basic authentication is absent.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Unknown user",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "BasicAuth": []
          }
        ]
      },
      "delete": {
        "summary": "Log out by expiring the session cookie",
        "description": "Expires the simple_comment_token cookie in the browser. Previously issued JWTs remain valid until their own expiration.",
        "security": [],
        "responses": {
          "202": {
            "description": "Logout acknowledged",
            "headers": {
              "Set-Cookie": {
                "description": "Sets simple_comment_token to logged-out with an expiration date in the past.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "Logged out"
              }
            }
          }
        }
      }
    },
    "/gauth": {
      "get": {
        "summary": "Issue a guest authentication token",
        "description": "Sets the simple_comment_token cookie on a successful request. The response body is OK by default.",
        "security": [],
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "description": "Any non-empty value returns the JWT in the response body. If omitted or empty, the response body is OK.",
            "schema": {
              "type": "string"
            },
            "example": "true"
          }
        ],
        "responses": {
          "200": {
            "description": "Guest token issued. The body contains OK or the JWT, depending on the token query parameter.",
            "headers": {
              "Set-Cookie": {
                "description": "Sets the HttpOnly simple_comment_token cookie to the JWT. The cookie uses SameSite=Strict or SameSite=None with Secure, depending on the deployment configuration.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "OK"
              }
            }
          },
          "403": {
            "description": "Guest accounts are forbidden according to policy `isGuestAccountAllowed:false`",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "description": "Too many hits on this endpoint in a short amount of time",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "/verify": {
      "get": {
        "summary": "Verify a token and return its claims",
        "description": "Send the JWT in the simple_comment_token cookie or as an HTTP Bearer token. If both are present, the cookie takes precedence.",
        "responses": {
          "200": {
            "description": "Verified JWT claims",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["user", "exp"],
                  "properties": {
                    "user": {
                      "type": "string",
                      "description": "User ID"
                    },
                    "exp": {
                      "type": "integer",
                      "description": "Expiration time in seconds since the Unix epoch"
                    },
                    "iat": {
                      "type": "integer",
                      "description": "Issuance time in seconds since the Unix epoch"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Token is malformed or invalid",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "No authentication token was supplied",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Token has expired",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "CookieAuth": []
          },
          {
            "BearerAuth": []
          }
        ]
      }
    }
